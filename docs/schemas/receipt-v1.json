{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "session": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "incomplete": {
          "enum": [
            0,
            1
          ]
        }
      },
      "required": [
        "id",
        "base",
        "agent",
        "incomplete"
      ],
      "additionalProperties": false
    },
    "nodes": {
      "type": "object",
      "maxProperties": 10000,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "observation"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "fingerprint": {
                "type": "object",
                "properties": {
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "mode": {
                    "enum": [
                      "100644",
                      "100755"
                    ]
                  },
                  "python_ast_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "sha256",
                  "mode"
                ],
                "additionalProperties": false
              },
              "complete": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "kind",
              "path",
              "revision",
              "fingerprint",
              "complete"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "claim",
                  "decision"
                ]
              },
              "text": {
                "type": "string"
              },
              "groups": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "required": [
              "id",
              "kind",
              "text",
              "groups"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "action"
              },
              "text": {
                "type": "string"
              },
              "groups": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "executed": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "kind",
              "text",
              "groups",
              "executed"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "session",
    "nodes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
